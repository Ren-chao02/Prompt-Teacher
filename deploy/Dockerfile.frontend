# Prompt Teacher Frontend - Vue Application
# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# 复制 package 文件
COPY frontend/admin-panel/package*.json ./

# 安装依赖
RUN npm ci --only=production

# 复制源代码
COPY frontend/admin-panel/ .

# 构建生产版本
RUN npm run build

# Stage 2: Production
FROM nginx:alpine

# 复制 Nginx 配置
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 复制构建产物到 /admin 子目录，与 vite base:'/admin/' 及 nginx.conf 的 location /admin/ 对齐
COPY --from=builder /app/dist /usr/share/nginx/html/admin

# 暴露端口
EXPOSE 80

# 健康检查（用 127.0.0.1 避免 alpine localhost 解析到 IPv6 ::1 导致误报不健康）
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
