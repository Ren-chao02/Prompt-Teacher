# ============================================
# Prompt Teacher 环境配置
# 修改此文件后需重建 backend 容器生效：
#   docker compose up -d --build backend
# ============================================

# 后端 Django 服务端口
DJANGO_PORT=8001

# 前端 Vite 开发服务器端口
VITE_PORT=8002

# 后端 API 地址（前端通过 Vite proxy 转发，生产环境改为实际地址）
API_BASE_URL=

# ---------- 公网访问（Cloudflare Tunnel）相关配置 ----------
# 关闭调试模式（公网部署必须关闭，避免泄露源码/环境变量）
DEBUG=False

# 允许的 Host：.trycloudflare.com 匹配所有 trycloudflare 隧道随机子域名
# 如改用固定域名，请替换为你的域名（如 .example.com）
ALLOWED_HOSTS=.trycloudflare.com,localhost,127.0.0.1,backend

# CSRF 信任来源：必须包含隧道实际访问地址（含 https://）
# https://*.trycloudflare.com 通配所有 trycloudflare 隧道，免去每次重启重配
# 本地访问保留 http 条目
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,http://localhost:8081,http://127.0.0.1:8081
