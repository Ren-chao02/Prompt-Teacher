# ============================================
# Prompt Teacher 端口统一配置
# 修改此文件后重启服务生效
# ============================================

# 后端 Django 服务端口
DJANGO_PORT=8001

# 前端 Vite 开发服务器端口
VITE_PORT=8002

# 后端 API 地址（前端通过 Vite proxy 转发，生产环境改为实际地址）
# 开发模式：留空（自动拼接 localhost:DJANGO_PORT）
# 生产模式：填入如 https://api.example.com
API_BASE_URL=
